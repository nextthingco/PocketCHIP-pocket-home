#!/usr/bin/make -f

# Built NATIVELY -- build.sh runs dpkg-buildpackage inside an armhf container, so
# there is no cross-compiler override (the old rules forced
# CXX=arm-linux-gnueabihf-g++, which clashes with the native build).
%:
	dh $@

# The Projucer Makefile builds into build/Release/ and has no install or test
# target; debian/install places the binary + assets, so skip the auto steps.
override_dh_auto_install:

override_dh_auto_test:
